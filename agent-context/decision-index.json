    {
      "id": "ADR-M365-MATTER-ACCESS-004",
      "title": "Apply live-smoke is a separate owner-gated release lane",
      "status": "accepted",
      "decision_date": "2026-07-08",
      "domain": "m365_matter_access_delegation",
      "owner": "ofunk",
      "summary": "The real matter-access apply smoke writes and deletes synthetic SharePoint list items, so it is not a silent default in the one-shot release gate. It requires explicit owner approval and is attached to release-gate evidence only via an explicit artifact path.",
      "source_paths": [
        "docs/de/operations/m365-matter-access-apply-live-smoke-release-lane.md",
