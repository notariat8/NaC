    {
      "id": "ADR-M365-MATTER-ACCESS-003",
      "title": "Graph REST request plans precede owner-gated live writes",
      "status": "accepted",
      "decision_date": "2026-07-08",
      "domain": "m365_matter_access_delegation",
      "owner": "ofunk",
      "summary": "The domain flow stays Graph REST v1.0 only. Offline request plans, readiness checks and redacted evidence must pass before any owner-gated live write path is used.",
      "source_paths": [
        "docs/de/architecture/teams-sharepoint-graph-data-plane.md",
