    {
      "id": "ADR-M365-MATTER-ACCESS-002",
      "title": "Deputy access is a timeboxed exception with reason and audit correlation",
      "status": "accepted",
      "decision_date": "2026-07-08",
      "domain": "m365_matter_access_delegation",
      "owner": "ofunk",
      "summary": "Deputy access is modeled through Vertretungsfreigaben with reason, validity window, approver, status and audit correlation. Permanent or unreasoned deputy grants are outside the MVP boundary.",
      "source_paths": [
        "docs/de/architecture/m365-matter-access-delegation.md",
        "docs/en/architecture/m365-matter-access-delegation.md",
