      "id": "ADR-M365-MATTER-ACCESS-001",
      "title": "Matter visibility is bound to the assigned notary team",
      "status": "accepted",
      "decision_date": "2026-07-08",
      "domain": "m365_matter_access_delegation",
      "context_key": "m365_matter_access_apply_live_smoke_release_lane",
      "owner": "ofunk",
      "summary": "The MVP uses a private Microsoft 365 Team and SharePoint site per notary team. Matters reference the responsible team and assigned people instead of being visible to all notary-office users.",
      "source_paths": [
