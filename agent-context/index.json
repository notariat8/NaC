{
  "schema_version": "nac.agent-context-index/v0.1",
  "index_id": "codex_agent_context",
  "status": "active_mvp",
  "purpose": "Agent-readable router for loading the right NaC context at the right time without turning AGENTS.md into an encyclopedia.",
  "guardrails": {
    "root_agents_md_is_router": true,
    "real_mandate_data_allowed": false,
    "secrets_allowed": false,
    "runtime_logs_loaded_only_for_current_task": true,
    "external_memory_is_source_of_shared_truth": true
  },
  "layers": [
    {
      "id": "always_on",
      "description": "Stable invariants and navigation loaded at session start.",
      "paths": [
        "AGENTS.md",
        ".codex/config.toml",
        "docs/de/START_HERE.md",
        "docs/en/START_HERE.md",
        "policies/technology-policy.yaml",
        "policies/data-protection-policy.yaml",
        "policies/language-policy.yaml"
      ]
    },
    {
      "id": "scoped",
      "description": "Directory- or domain-specific instructions loaded when files in that scope are touched.",
      "paths": [
        "docs/AGENTS.md",
        "workflows/contracts/AGENTS.md",
        ".codex/agents/nac-scope-mapper.toml",
        ".codex/agents/nac-policy-reviewer.toml",
        ".codex/agents/nac-docs-parity-reviewer.toml",
        ".codex/agents/nac-validation-reviewer.toml",
        ".codex/agents/nac-kg-reviewer.toml",
        ".codex/agents/nac-bpmn-reviewer.toml",
        "agent-context/subagent-registry.json"
      ]
    },
    {
      "id": "on_demand",
      "description": "Architecture maps, decisions, guardrails and runbooks loaded only when relevant.",
      "categories": [
        {
          "id": "maps",
          "description": "System shape and dependency maps.",
          "paths": [
            "docs/de/architecture/teams-sharepoint-graph-data-plane.md",
            "docs/en/architecture/teams-sharepoint-graph-data-plane.md",
            "docs/de/architecture/nemo-agent-toolkit-aiq-m365.md",
            "docs/en/architecture/nemo-agent-toolkit-aiq-m365.md",
            "workflows/contracts/README.md"
          ]
        },
        {
          "id": "history",
          "description": "Why decisions were made.",
          "paths": [
            "agent-context/decision-index.json",
            "docs/de/technology-decision.md",
            "docs/en/technology-decision.md",
            "docs/de/operations/codex-worktree-operating-model.md",
            "docs/en/operations/codex-worktree-operating-model.md"
          ]
        },
        {
          "id": "worktree_operating_model",
          "description": "Read-only worktree hygiene audit, branch isolation and owner-gated cleanup boundaries.",
          "paths": [
            "docs/de/operations/codex-worktree-operating-model.md",
            "docs/en/operations/codex-worktree-operating-model.md",
            "src/nac_git/worktree_hygiene.py",
            "scripts/validate_codex_worktree_operating_model.py",
            "tests/test_codex_worktree_operating_model.py",
            "workflows/verification-contracts/codex-worktree-operating-model.verification.json"
          ]
        },
        {
          "id": "guardrails",
          "description": "Rules that prevent critical behavior from being broken.",
          "paths": [
            "agent-context/invariant-index.json",
            "CODEOWNERS",
            ".github/PULL_REQUEST_TEMPLATE.md",
            "docs/de/quality-gate.md",
            "docs/en/quality-gate.md",
            "workflows/verification-contracts/codex-agent-context.verification.json",
            "workflows/verification-contracts/m365-matter-access-delegation.verification.json"
          ]
        },
        {
          "id": "subagent_operating_gate",
          "description": "Exact read-only subagent registry, runtime limits and batch thresholds.",
          "paths": [
            "agent-context/subagent-registry.json",
            "docs/de/operations/codex-subagent-operating-gate.md",
            "docs/en/operations/codex-subagent-operating-gate.md",
            "workflows/contracts/codex-parallel-review.contract.json",
            "scripts/validate_codex_subagent_operating_gate.py",
            "tests/test_codex_subagent_operating_gate.py",
            "workflows/verification-contracts/codex-subagent-operating-gate.verification.json"
          ]
        },
        {
          "id": "command_rules",
          "description": "Reusable command permission profiles for GREEN/YELLOW/RED shell-command governance.",
          "paths": [
            "policies/codex-command-rules-policy.json",
            ".codex/rules/README.md",
            ".codex/rules/default.rules",
            "docs/de/operations/codex-command-rules-operating-model.md",
            "docs/en/operations/codex-command-rules-operating-model.md",
            "scripts/validate_codex_command_rules_operating_model.py",
            "scripts/validate_codex_command_rules_adoption.py",
            "tests/test_codex_command_rules_operating_model.py",
            "tests/test_codex_command_rules_adoption.py",
            "workflows/verification-contracts/codex-command-rules.verification.json"
          ]
        },
        {
          "id": "memory_hooks",
          "description": "Local recall and hook operating model without live hook activation.",
          "paths": [
            "docs/de/operations/codex-memory-hooks-operating-model.md",
            "docs/en/operations/codex-memory-hooks-operating-model.md",
            ".codex/hooks/README.md",
            ".codex/hooks/pre_tool_use_policy.example.py",
            "scripts/validate_codex_memory_hooks_operating_model.py",
            "tests/test_codex_memory_hooks_operating_model.py",
            "workflows/verification-contracts/codex-memory-hooks.verification.json"
          ]
        },
        {
          "id": "m365_matter_access_apply_live_smoke_release_lane",
          "description": "Separate owner-gated release lane for synthetic SharePoint deputy-grant writes, readback, cleanup and redacted evidence.",
          "paths": [
            "docs/de/operations/m365-matter-access-apply-live-smoke-release-lane.md",
            "docs/en/operations/m365-matter-access-apply-live-smoke-release-lane.md",
            "src/nac_m365_graph/matter_access_apply_smoke.py",
            "src/nac_m365_graph/release_gate_evidence.py",
            "scripts/validate_m365_matter_access_apply_live_smoke_release_lane.py",
            "tests/test_m365_matter_access_apply_live_smoke_release_lane.py",
            "workflows/verification-contracts/m365-matter-access-apply-live-smoke-release-lane.verification.json"
          ]
        },
        {
          "id": "m365_matter_access_apply_live_smoke_retention",
          "description": "Correlation-based offline retention and index for redacted owner-gated matter-access apply live-smoke artifacts.",
          "paths": [
            "docs/de/operations/m365-matter-access-apply-live-smoke-release-lane.md",
            "docs/en/operations/m365-matter-access-apply-live-smoke-release-lane.md",
            "src/nac_m365_graph/matter_access_apply_live_smoke_retention.py",
            "scripts/provision_teams_sharepoint_graph.py",
            "src/nac_cli/cli.py",
            "scripts/validate_m365_matter_access_apply_live_smoke_retention.py",
            "tests/test_m365_matter_access_apply_live_smoke_retention.py",
            "workflows/verification-contracts/m365-matter-access-apply-live-smoke-retention.verification.json"
          ]
        }
      ]
    },
    {
      "id": "runtime",
      "description": "Task-specific prompts, tool output, logs, diffs and evidence loaded for the current run only.",
      "paths": [
        "out/quality/status.json",
        "out/quality/report.md",
        "out/m365/teams-sharepoint/"
      ],
      "load_policy": "only_after_command_execution_or_current_task_request"
    }
  ],
  "verification_contracts": [
    "workflows/verification-contracts/codex-agent-context.verification.json",
    "workflows/verification-contracts/codex-agent-context-index-audit.verification.json",
    "workflows/verification-contracts/codex-worktree-operating-model.verification.json",
    "workflows/verification-contracts/codex-subagent-operating-gate.verification.json",
    "workflows/verification-contracts/codex-memory-hooks.verification.json",
    "workflows/verification-contracts/codex-command-rules.verification.json",
    "workflows/verification-contracts/m365-matter-access-delegation.verification.json",
    "workflows/verification-contracts/m365-matter-access-apply-live-smoke-release-lane.verification.json",
    "workflows/verification-contracts/m365-matter-access-apply-live-smoke-retention.verification.json"
  ]
}
