<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:nac="https://github.com/notariat8/NaC/bpmn/nac"
                  id="Definitions_grundstueckskaufvertrag"
                  targetNamespace="https://github.com/notariat8/NaC/bpmn/notariat/usecases">
  <bpmn:process id="Process_grundstueckskaufvertrag"
                name="Grundstückskaufvertrag"
                isExecutable="false"
                nac:profile="nac-bpmn/v0.1"
                nac:owner="funktion8 / ofunk"
                nac:binding="Git Pull Request">
    <bpmn:documentation>Generiert aus usecase-lokalem KG, BNotK-XNP-Onlinehilfe fuer lokale XNP-Schnittstelle und BNotK-Onlineverfahren-Onlinehilfe fuer Vorgangseingang/Videokonferenz. Keine Mandatswerte im Repo.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_VorgangAnlegen"
                     name="Vorgang anlegen"
                     nac:role="Notariat"
                     nac:channel="personal;email;phone;post"
                     nac:dataClass="metadata"
                     nac:approval="none"
                     nac:evidence="none"
                     nac:durationBand="same_day_or_internal"
                     nac:criticalPath="false"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:outgoing>Flow_00</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AuftragAufnehmen"
                     name="Auftrag und Beteiligte aufnehmen"
                     nac:role="Notariatsfachkraft"
                     nac:channel="personal;email;phone;post"
                     nac:dataClass="confidential_placeholder"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="short_party_turnaround"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_00</bpmn:incoming>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Task_FormFristenPruefen"
                     name="Zuständigkeit, Form und Fristen prüfen"
                     nac:role="Notariat"
                     nac:channel="internal"
                     nac:dataClass="metadata"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="same_day_or_internal"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="Task_UnterlagenPruefen"
                     name="Grundbuchstand und Unterlagen prüfen"
                     nac:role="Notariatsfachkraft"
                     nac:channel="land_register_portal;email;post;internal"
                     nac:dataClass="confidential_placeholder"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="standard_external"
                     nac:parallelGroup="pre_notarization"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EntwurfAbstimmen"
                     name="Urkundenentwurf und Vollzugshinweise abstimmen"
                     nac:role="Notariatsfachkraft"
                     nac:channel="email;post;land_register_portal;internal"
                     nac:dataClass="confidential_placeholder"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="short_party_turnaround"
                     nac:parallelGroup="pre_notarization"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_IdentitaetVertretung"
                     name="Identität und Vertretung prüfen"
                     nac:role="Notarin/Notar"
                     nac:channel="personal;paper_signature"
                     nac:dataClass="confidential_placeholder"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="same_day_or_internal"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Beurkundung"
                     name="Beurkundung oder Erklärung durchführen"
                     nac:role="Notarin/Notar"
                     nac:channel="personal;paper_signature"
                     nac:dataClass="confidential_placeholder"
                     nac:approval="four_eyes"
                     nac:evidence="required"
                     nac:durationBand="same_day_or_internal"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="Task_XnpXnotarGrenzePruefen"
                     name="Lokale XNP-/XNotar-Grenze prüfen"
                     nac:role="Notariatsfachkraft"
                     nac:channel="xnp_local;xnotar_xjustiz;internal"
                     nac:dataClass="no_mandate_data"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="same_day_or_internal"
                     nac:parallelGroup="xnp_boundary"
                     nac:criticalPath="false"
                     nac:localExecution="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_06b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_PostNotarizationSplit"
                     name="Externe Vollzugsgates parallel starten"
                     nac:role="Notariat"
                     nac:channel="internal"
                     nac:dataClass="metadata"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="short_party_turnaround"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_06b</bpmn:incoming>
      <bpmn:outgoing>Flow_07a</bpmn:outgoing>
      <bpmn:outgoing>Flow_07b</bpmn:outgoing>
      <bpmn:outgoing>Flow_07c</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_VormerkungBeantragen"
                     name="Eigentumsvormerkung über Grundbuchpfad beantragen"
                     nac:role="Notariatsfachkraft"
                     nac:channel="xnotar_xjustiz;land_register_portal"
                     nac:dataClass="no_mandate_data"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="standard_external"
                     nac:parallelGroup="post_notarization"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_07a</bpmn:incoming>
      <bpmn:outgoing>Flow_08a</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_LoeschungsunterlagenNachhalten"
