                     nac:role="Notariatsfachkraft"
                     nac:channel="authority;post;email"
                     nac:dataClass="no_mandate_data"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="standard_external"
                     nac:parallelGroup="post_notarization"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_07c</bpmn:incoming>
      <bpmn:outgoing>Flow_08c</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Gateway_FaelligkeitJoin"
                     name="Fälligkeitsvoraussetzungen vollständig"
                     nac:role="Notariat"
                     nac:channel="internal"
                     nac:dataClass="metadata"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="standard_external"
                     nac:parallelGroup="post_notarization"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_08a</bpmn:incoming>
      <bpmn:incoming>Flow_08b</bpmn:incoming>
      <bpmn:incoming>Flow_08c</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_KaufpreisfaelligkeitMitteilen"
                     name="Kaufpreisfälligkeit mitteilen"
                     nac:role="Notariat"
                     nac:channel="email;post"
                     nac:dataClass="no_mandate_data"
                     nac:approval="human"
                     nac:evidence="required"
                     nac:durationBand="short_party_turnaround"
                     nac:parallelGroup="post_notarization"
                     nac:criticalPath="true"
                     nac:kgRef="grundstueckskaufvertrag">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UnbedenklichkeitNachhalten"
