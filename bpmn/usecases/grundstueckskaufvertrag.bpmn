    <bpmn:sequenceFlow id="Flow_08a" sourceRef="Task_VormerkungBeantragen" targetRef="Gateway_FaelligkeitJoin"/>
    <bpmn:sequenceFlow id="Flow_08b" sourceRef="Task_LoeschungsunterlagenNachhalten" targetRef="Gateway_FaelligkeitJoin"/>
    <bpmn:sequenceFlow id="Flow_08c" sourceRef="Task_VorkaufsrechtKlaeren" targetRef="Gateway_FaelligkeitJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_FaelligkeitJoin" targetRef="Task_KaufpreisfaelligkeitMitteilen"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_KaufpreisfaelligkeitMitteilen" targetRef="Task_UnbedenklichkeitNachhalten"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_UnbedenklichkeitNachhalten" targetRef="Task_EigentumsumschreibungEinreichen"/>
