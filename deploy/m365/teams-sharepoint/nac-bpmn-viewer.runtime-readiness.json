{
  "schema_version": "nac.m365-bpmn-viewer-runtime-readiness/v0.1",
  "name": "nac-bpmn-viewer-runtime-readiness",
  "status": "offline_runtime_readiness_no_live_deploy",
  "last_update": "2026-07-07",
  "purpose": "Offline readiness gate for the future BPMN viewer runtime: SPFx package boundary, App Catalog deployment boundary and owner-gated Graph REST content read of approved .bpmn files.",
  "source_artifacts": {
    "viewer_contract": "workflows/contracts/m365-sharepoint-bpmn-viewer-adapter.contract.json",
    "provisioning_plan": "deploy/m365/teams-sharepoint/nac-bpmn-viewer.provisioning.json",
    "spfx_skeleton": "deploy/m365/teams-sharepoint/nac-spfx-bpmn-viewer.skeleton.json",
    "package_root": "spfx/nac-bpmn-viewer",
    "render_fixture": "tests/fixtures/m365/spfx-bpmn-viewer/render-contract.fixture.json"
  },
  "spfx_packaging_boundary": {
    "package_root": "spfx/nac-bpmn-viewer",
    "package_json_required": true,
    "package_solution_json_required": true,
    "manifest_required": true,
    "npm_install_allowed_now": false,
    "build_allowed_now": false,
    "bundle_allowed_now": false,
    "package_solution_allowed_now": false,
    "sppkg_included_now": false,
    "lockfile_allowed_now": false,
    "node_modules_allowed_now": false,
    "future_owner_gate_required_before_package": true,
    "future_validation_before_package": [
      "npm install in an isolated SPFx package workspace",
      "npm audit or equivalent dependency review",
      "SPFx bundle validation",
      "SPFx package-solution validation",
      "license and SBOM delta review"
    ]
  },
  "app_catalog_deploy_gate": {
    "app_catalog_upload_allowed_now": false,
    "tenant_wide_deploy_allowed_now": false,
    "site_scoped_install_allowed_now": false,
    "requires_owner_gate": true,
    "requires_sharepoint_admin_role": true,
    "requires_app_catalog_site": true,
    "requires_separate_pr_with_package_artifact": true,
    "requires_rollback_plan": true,
    "requires_post_deploy_read_only_smoke": true
  },
  "graph_bpmn_content_read_gate": {
    "graph_base_url": "https://graph.microsoft.com/v1.0",
    "graph_rest_only": true,
    "graph_sdk_allowed": false,
    "legacy_sharepoint_api_allowed": false,
    "pnp_allowed": false,
    "csom_allowed": false,
    "live_content_read_enabled_now": false,
    "future_endpoint": "GET /sites/{site-id}/drives/{drive-id}/items/{item-id}/content",
    "allowed_file_extensions": [
      ".bpmn"
    ],
    "required_metadata_gates": [
      "ApprovalStatus=Approved",
      "ViewerEnabled=true",
      "ContainsMatterData=false",
      "BpmnXmlSha256 matches downloaded XML",
      "NacDataClass in Template,Demo,Reference"
    ],
    "permission_model": "future_owner_gated_sites_selected_read",
    "allowed_content_class": "approved_bpmn_xml_only",
    "forbidden_content_classes": [
      "matter_document_content",
      "mandate_payload",
      "tokens_or_secrets"
    ]
  },
  "evidence_expectations": {
    "command": "nac m365 teams-sharepoint bpmn-viewer-runtime-readiness --format json",
    "output_kind": "redacted_offline_readiness_json",
    "must_include": [
      "spfx_packaging_boundary",
      "app_catalog_deploy_gate",
      "graph_bpmn_content_read_gate",
      "guardrails"
    ],
    "must_not_include": [
      "secrets",
      "tokens",
      "raw_matter_document_content",
      "live_bpmn_xml_content"
    ]
  },
  "blocked_operations": [
    "npm_install",
    "spfx_bundle",
    "spfx_package_solution",
    "create_sppkg",
    "app_catalog_upload",
    "site_app_install",
    "tenant_wide_deploy",
    "live_tenant_apply",
    "live_bpmn_content_read",
    "write_bpmn_xml",
    "save_bpmn_model",
    "execute_workflow",
    "start_process_instance",
    "read_matter_document_content",
    "read_matter_payload",
    "store_tokens_or_secrets",
    "legacy_sharepoint_rest",
    "sharepoint_csom",
    "pnp",
    "microsoft_graph_sdk",
    "graph_beta"
  ],
  "validation_commands": [
    "python3 -m unittest tests.test_m365_bpmn_viewer_runtime_readiness",
    "python3 scripts/validate_m365_sharepoint_bpmn_viewer_adapter.py",
    "python3 scripts/quality_gate.py --profile strict"
  ]
}
