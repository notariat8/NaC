{
  "name": "@notariat8/nac-bpmn-viewer",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "build": "npm run validate:current-step && npm run validate:read-only && npm run visual:fixture -- /tmp/nac-spfx-role-deadline-cockpit.html && heft test --clean --production && heft package-solution --production",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "start": "heft start --clean",
    "validate:current-step": "node scripts/validate-current-step-contract.cjs",
    "visual:fixture": "node scripts/generate-role-deadline-visual-fixture.cjs",
    "visual:capture": "node scripts/capture-role-deadline-visual-evidence.cjs",
    "workbench:fixture": "node scripts/generate-workbench-visual-fixture.cjs",
    "workbench:capture": "heft test --clean --production && node scripts/capture-workbench-visual-evidence.cjs",
    "workbench:live:fixture": "node scripts/generate-workbench-live-read-visual-fixture.cjs",
    "workbench:live:capture": "heft test --clean --production && node scripts/capture-workbench-live-read-visual-evidence.cjs",
    "validate:read-only": "node scripts/validate-read-only-boundary.cjs"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-http": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "bpmn-js": "17.11.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "playwright": "1.55.0",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  },
  "resolutions": {
    "@types/react": "17.0.45"
  },
  "license": "AGPL-3.0-or-later"
}
