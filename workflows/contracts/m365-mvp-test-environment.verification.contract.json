  "acceptance_criteria": [
    {
      "id": "AC-620-01",
      "requirement": "A reproducibly built, site-scoped and installable SPFx package declares SharePointWebPart and TeamsTab hosts and sets skipFeatureDeployment=false."
    },
    {
      "id": "AC-620-02",
      "requirement": "SPFx never requests Microsoft Graph permissions or calls Graph directly; its only permitted dynamic API target is the delegated NaC BFF scope Matter.Read provisioned under owner-gated Issue #632, with final live verification still pending."
    },
    {
      "id": "AC-620-03",
      "requirement": "The BFF derives user identity only from a validated Entra access token and resolves workspace, site and list identifiers exclusively through a server-side allowlist; final live token validation is required in the current twelve-step closure run."
    },
    {
      "id": "AC-620-04",
      "requirement": "An assigned user receives only a redacted projection containing synthetic matter status, tasks, due date and BPMN; the current SharePoint and Teams delivery path requires final live verification on current main."
    },
    {
      "id": "AC-620-05",
      "requirement": "Unassigned users and manipulated workspace, matter, purpose or filter inputs fail closed without revealing whether the matter exists or exposing its metadata."
    },
    {
      "id": "AC-620-06",
      "requirement": "Site-scoped SharePoint and optional Teams deployment, Graph REST v1.0 write/readback, run-owned cleanup and their evidence are reproducible and redacted."
    },
    {
      "id": "AC-620-07",
      "requirement": "The closure run creates no credential or unbounded permission, touches no production data and performs no operation in any workspace other than notary_team_01; under the bounded Issue #632 supersession it may create an absent exact binding or reuse an exact existing binding only for Matter.Read plus runtime Sites.Selected with site role read; any mismatched, duplicate or broader binding fails closed without in-place repair."
    }
  ],
