    "allowlistedEvidenceFieldsExact": [
      "schema_version",
      "mutation_id",
      "execution_key",
      "operation",
      "target_binding_hash",
      "plan_sha256",
      "authorization_run_identity",
      "result_code",
      "s5_operation_hash",
      "http_status",
      "intent_generation",
      "expected_intent_generation",
      "prior_authorization_run_identity",
      "close_intent",
      "completion_state"
