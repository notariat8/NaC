  "offlineCompletion": {
    "statusExact": "S4C_COMPOSITION_READY_OFFLINE",
    "liveGraphCallsExact": 0,
    "tenantWritesExact": 0,
    "centralDurabilityClaimed": false,
    "productionReadyClaimed": false,
    "socketOrDnsCallsExact": 0,
    "externalCredentialStoreReadsExact": 0,
