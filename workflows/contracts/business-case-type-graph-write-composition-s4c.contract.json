  "outOfScopeExact": [
    "central_multi_instance_state",
    "credential_factory",
    "entra_permission_change",
    "live_execute_command",
    "live_graph_call",
    "live_reconciliation",
    "s6_worm_publisher_composition",
    "tenant_write",
    "write_identity_provisioning"
