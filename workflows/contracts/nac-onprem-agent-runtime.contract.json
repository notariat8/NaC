{
  "schema_version": "nac.workflow-contract/v0.1",
  "contract_id": "workflow.nac_onprem_agent_runtime",
  "title": "NaC-On-Prem-Agent-Runtime-Vertrag",
  "status": "archived_legacy_no_productive_connector_apply",
  "last_update": "2026-07-06",
  "purpose": "Definiert die Grenze, in der NaC produktive agentische Workflows mit NVIDIA NeMo Agent Toolkit und AI-Q führt, während der bestehende NemoClaw/OpenClaw-Lauf auf notoclaw01 nur Target-Control-Evidence bleibt und NaC-GitOps, Review, Owner-Gates oder Mandatsdatenschutz nicht umgeht.",
  "operating_model": {
    "project_manager": {
      "location": "brev01 main chat",
      "responsibility": "Scope, Architekturentscheidungen, Akzeptanzkriterien, Owner-Fragen, GitOps und PRs koordinieren."
    },
    "dev_agent": {
      "location": "brev01 NaC repository",
      "responsibility": "Code, Doku, Verträge, Tests, Validatoren, PRs, CI und Releases umsetzen."
    },
    "target_operator": {
      "location": "notoclaw01-host:/home/ubuntu/nac-target-control",
      "responsibility": "NemoClaw/OpenClaw-Zielsystem, Agent-Manifest, lokale Smokes, Evidence und Runbooks prüfen."
    }
  },
  "agentic_toolkit_decision": {
    "approved_agentic_toolkit": "nvidia_nemo_agent_toolkit",
    "approved_agentic_toolkit_docs": "https://docs.nvidia.com/nemo/agent-toolkit/latest/index.html",
    "aiq_blueprint": "https://build.nvidia.com/nvidia/aiq",
    "exclusive_for_productive_agentic_workflows": true,
    "python_first": true,
    "exceptions_require_owner_gate": true,
    "scope": [
      "agent_orchestration",
      "agent_workflows",
      "tool_calling",
      "mcp_client_tool_binding",
      "agent_runtime_packaging"
    ],
    "exceptions_allowed_for": [
      "deterministic_python_validators",
      "office_addin_ui",
      "mcp_server_adapters",
      "event_store_and_worm_storage",
      "local_device_connectors"
    ],
    "blocked_without_owner_gate": [
      "langchain_as_primary_runtime",
      "crewai_as_primary_runtime",
      "openclaw_runtime_activation",
      "custom_agent_framework_as_primary_runtime"
    ]
  },
  "source_of_truth": {
    "git": [
      "nac_repo_code",
      "nac_repo_contracts",
      "nac_repo_governance",
      "nac_repo_bpmn",
      "nac_repo_knowledge_graphs",
      "nac_repo_tests",
      "nac_outbound_connector_code",
      "oci_landing_zone_iac"
    ],
    "target_control": [
      "target_manifests",
      "target_runbooks",
      "target_local_smokes",
      "target_non_sensitive_evidence"
    ],
    "not_source_of_truth": [
      "/home/ubuntu/.codex",
      "/home/ubuntu/.nemoclaw",
      "/sandbox/.openclaw/workspace-*"
    ]
  },
  "variant_c_outbound_connector": {
    "status": "architecture_decision_no_productive_apply",
    "public_entry": "oci_idp_api_gateway_or_bff",
    "recommended_transport": "outbound_mtls_or_websocket_https_from_notoclaw_to_oci",
    "ssh_productive_transport_allowed": false,
    "direct_browser_to_brev_allowed": false,
    "raw_notoclaw_ui_publication_allowed": false,
    "oci_controls": [
      "identity_authentication",
      "session_binding",
      "tenant_policy",
      "agent_registry_api",
      "audit_metadata",
      "optional_atp_runtime_store"
    ],
    "notoclaw_controls": [
      "sandbox_lifecycle",
      "local_agent_runtime",
      "local_runtime_state",
      "redacted_status_signals"
    ],
    "sandbox_allocation": {
      "shared_sandbox_for_multiple_users_allowed": false,
      "minimum_isolation_key": "tenant_user",
      "preferred_isolation_key": "tenant_user_matter_role",
      "reuse_requires_active_lease_check": true,
      "owner_gate_before_productive_auto_start": true
    }
  },
  "runtime_persistence": {
    "git": [
      "connector_source_code",
      "contracts",
      "runbooks",
      "policies",
      "tests",
      "bpmn_templates",
      "knowledge_graph_templates"
    ],
    "atp": [
      "tenant_registry",
      "idp_subject_binding",
      "user_role_binding",
      "agent_registry",
      "sandbox_binding",
      "sandbox_lease",
      "session_binding",
      "audit_event_metadata"
    ],
    "notoclaw01": [
      "running_sandboxes",
      "sandbox_runtime_state",
      "local_openclaw_workspace_state",
      "non_sensitive_target_control_evidence"
    ],
    "oci_vault": [
      "connector_credentials",
      "mtls_material",
      "api_shared_secrets",
      "private_keys"
    ],
    "forbidden_in_git": [
      "runtime_sandbox_state",
      "idp_tokens_or_claims",
      "connector_credentials",
      "private_keys",
      "matter_payloads",
      "dashboard_tokens"
    ]
  },
  "target_control": {
    "host_label": "notoclaw01-host",
    "control_path": "/home/ubuntu/nac-target-control",
    "runtime_family": "NemoClaw/OpenClaw",
    "manifest_path": "blueprints/nac-onprem/agents.yaml",
    "workspace_template_path": "blueprints/nac-onprem/workspace-template",
    "required_workspace_template_files": [
      "AGENTS.md",
      "IDENTITY.md",
      "SOUL.md",
      "USER.md",
      "MEMORY.md"
    ],
    "skill_path": "skills/nac-agent/SKILL.md",
    "mcp_readme_path": "mcp/nac/README.md",
    "connector_paths": [
      "connectors/xnp/README.md",
      "connectors/cyberjack/README.md",
      "connectors/register/README.md"
    ],
    "smoke_commands": [
      "bin/nac-target-smoke",
      "bin/nac-runtime-smoke"
    ],
    "runtime_smoke": {
      "status": "ready_owner_gated_not_executed",
      "runbook_de": "docs/de/operations/nac-runtime-smoke.md",
      "runbook_en": "docs/en/operations/nac-runtime-smoke.md",
      "evidence_template": "workflows/evidence-templates/nac-runtime-smoke.md",
      "target_evidence_directory": "/home/ubuntu/nac-target-control/evidence",
      "target_evidence_file_pattern": "evidence/nac-runtime-smoke-YYYY-MM-DD.md",
      "public_origin_env": "NAC_PUBLIC_ORIGIN",
      "public_origin_config_path": "config/public-origin",
      "public_origin_required": true,
      "production_public_origin_requires_fixed_domain": true,
      "production_public_origin_dns_backed_required": true,
      "temporary_tunnel_origin_allowed_for_demo_only": true,
      "temporary_tunnel_origin_provider_specific_production_default_allowed": false,
      "temporary_tunnel_origin_production_allowed": false,
      "hardcoded_public_origin_default_allowed": false,
      "quick_tunnel_origin_default_allowed": false,
      "owner_apply_required_before_execution": true,
      "execution_performed": false,
      "installation_performed": false,
      "onboard_performed": false,
      "rebuild_performed": false,
      "lifecycle_hooks_enabled": false,
      "openclaw_runtime_mutation_performed": false,
      "dashboard_token_captured": false,
      "github_write_performed": false,
      "oci_write_performed": false,
      "secrets_required": false,
      "matter_data_required": false
    },
    "evidence_path": "evidence/2026-06-28-nac-onprem-agent-solution.md"
  },
  "required_agent_roles_or_names": [
    "main",
    "notary-flow",
    "evidence",
    "connector-ops"
  ],
  "required_mcp_servers": [
    {
      "id": "nac-workflow-mcp",
      "placement": "central_serverless_or_container",
      "purpose": "NaC-BPMN-, Knowledge-Graph-, Prozessstatus- und nächste-Aktion-Werkzeuge für NeMo/AI-Q.",
      "data_boundary": "metadata_only_no_raw_matter_payloads",
      "write_policy": "owner_or_role_gate_required"
    },
    {
      "id": "nac-access-grant-mcp",
      "placement": "central_serverless_or_container",
      "purpose": "Rollen-, Akten-, Zweck-, Vertretungs- und zeitbegrenzte Freigabeprüfung.",
      "data_boundary": "grant_metadata_and_audit_only",
      "write_policy": "human_approval_and_duration_required"
    },
    {
      "id": "m365-mail-calendar-mcp",
      "placement": "central_serverless_or_workstation_sidecar",
      "purpose": "Outlook-Mail-, Kalender-, Frei- und Belegt- sowie Meeting-Kontext über Microsoft Graph.",
      "data_boundary": "least_privilege_graph_access_no_bulk_export",
      "write_policy": "draft_or_send_only_after_human_approval"
    },
    {
      "id": "m365-teams-mcp",
      "placement": "central_serverless_or_container",
      "purpose": "Teams-Chat-, Kanal-, Thread- und Meetingnachrichten über Microsoft Graph.",
      "data_boundary": "case_bound_retrieval_no_unbounded_chat_dump",
      "write_policy": "reply_or_post_only_after_human_approval"
    },
    {
      "id": "m365-files-mcp",
      "placement": "central_serverless_or_container",
      "purpose": "OneDrive- und SharePoint-Drives, Dokumentbibliotheken, Listen, Delta- und Webhook-Signale über Microsoft Graph.",
      "data_boundary": "document_pointer_metadata_first_private_payload_gate_for_content",
      "write_policy": "document_mutation_only_after_role_case_gate"
    },
    {
      "id": "entra-identity-mcp",
      "placement": "central_serverless_or_container",
      "purpose": "Entra-ID-Subjekte, Gruppen, App-Rollen und Consent-Evidence für NaC-Rollenbindung.",
      "data_boundary": "identity_metadata_only_no_token_or_raw_claim_storage",
      "write_policy": "admin_owner_gate_required_for_directory_writes"
    },
    {
      "id": "nac-document-mcp",
      "placement": "central_private_runtime",
      "purpose": "Dokumentenumschläge, Pointer, Hashes, Versionen, Track-Changes-Status und Extraktionsjobs.",
      "data_boundary": "raw_documents_remain_in_approved_private_storage",
      "write_policy": "private_payload_gate_and_audit_required"
    },
    {
      "id": "nac-audit-evidence-mcp",
      "placement": "central_serverless_or_container",
      "purpose": "Append-only Ereignisjournal, WORM-Nachweis, Zugriff, Freigabe, Widerruf und Runtime-Evidence.",
      "data_boundary": "redacted_evidence_no_secret_or_raw_payload",
      "write_policy": "append_only"
    },
    {
      "id": "local-workstation-mcp",
      "placement": "per_workstation_wsl_container_or_local_sidecar",
      "purpose": "Lokale Word-/Office-Brücke, Kartenarbeitsplatz, Scanner/OCR, XNP-Readiness und Arbeitsplatzsignale.",
      "data_boundary": "local_cache_or_outbox_only_central_truth_required",
      "write_policy": "outbound_only_after_central_lease"
    },
    {
      "id": "nac-office-addin-mcp",
      "placement": "optional_workstation_or_app_backend",
      "purpose": "Optionale Word- und Teams-Add-in-Kommandos, falls die Benutzeroberfläche nicht direkt über NeMo/AI-Q-UI abgebildet wird.",
      "data_boundary": "ui_commands_and_document_pointers_only",
      "write_policy": "human_in_the_loop_required"
    }
  ],
  "connector_boundaries": [
    {
      "id": "xnp_snp",
