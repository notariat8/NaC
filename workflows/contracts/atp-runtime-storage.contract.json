{
  "schema_version": "nac.atp-runtime-storage/v0.1",
  "contract_id": "runtime.atp_storage",
  "title": "ATP Runtime Storage Contract",
  "status": "contract_first_no_schema_apply",
  "last_update": "2026-06-25",
  "runtime_data_plane": "oracle_atp",
  "purpose": "Define the first safe runtime-storage boundary for NaC tenants, users, sessions, matters, process instances, process events and audit metadata before any productive schema or graph activation.",
  "data_model_slice": {
    "id": "runtime_graph_metadata_v0",
    "scope": "safe_runtime_metadata_for_first_immobilienkaufvertrag_path",
    "primary_usecase": "immobilienkaufvertrag",
    "layers": [
      {
        "id": "transactional_anchors",
        "source": "atp",
        "contains": [
          "tenant_boundary",
          "matter_anchor",
          "process_instance_anchor",
          "append_only_process_events",
          "audit_metadata"
        ]
      },
      {
        "id": "json_payloads",
        "source": "atp",
        "contains": [
          "status_metadata",
          "gate_metadata",
          "duration_bands",
          "external_boundary_labels",
          "redacted_audit_references"
        ]
      },
      {
        "id": "graph_projection",
        "source": "process_events",
        "contains": [
          "dependencies",
          "parallel_groups",
          "critical_path",
          "external_gate_touchpoints",
          "ontology_candidates"
        ]
      }
    ],
    "projection": {
      "source": "process_events",
      "target_contract": "nac.atp-runtime-graph-projection/v0.1",
      "oracle_graph_studio": "future_analysis_and_modeling_tool_after_owner_gate"
    },
    "blocked_until_separate_gate": [
      "productive_schema_apply",
      "oracle_graph_studio_activation",
      "raw_mandate_content",
      "productive_xnp_snp_action"
    ]
  },
  "source_of_truth": {
    "git": [
      "code",
      "iac",
      "governance",
      "bpmn_templates",
      "synthetic_demo_data"
    ],
    "atp": [
      "tenants",
      "user_bindings",
      "sessions",
      "matters",
      "process_instances",
      "process_events",
      "audit_metadata"
    ]
  },
  "transactional_anchors": [
    {
      "id": "tenants",
      "purpose": "Stable tenant boundary for a notary office or demo tenant.",
      "allowed_data_classes": [
        "safe_metadata_only",
        "tenant_public_label",
        "tenant_status"
      ],
      "blocked_data_classes": [
        "raw_mandate_content",
        "secrets",
        "tokens"
      ]
    },
    {
      "id": "user_bindings",
      "purpose": "Internal NaC user binding, separated from external identity-provider details.",
      "allowed_data_classes": [
        "safe_metadata_only",
        "subject_binding_reference",
        "role_binding_status"
      ],
      "blocked_data_classes": [
        "raw_mandate_content",
        "id_token",
        "access_token",
        "provider_claim_dump"
      ]
    },
    {
      "id": "sessions",
      "purpose": "Server-side session state; browser cookies remain short-lived opaque references.",
      "allowed_data_classes": [
        "safe_metadata_only",
        "session_status",
        "expiration_metadata"
      ],
      "blocked_data_classes": [
        "raw_mandate_content",
        "tokens",
        "claims",
        "provider_details"
      ]
    },
    {
      "id": "matters",
      "purpose": "Matter or case anchor for notarial process instances.",
      "allowed_data_classes": [
        "safe_metadata_only",
        "matter_type",
        "matter_status",
        "redacted_reference"
      ],
      "blocked_data_classes": [
        "raw_mandate_content",
        "personal_identifiers_without_separate_gate",
        "document_full_text"
      ]
    },
    {
      "id": "process_templates",
      "purpose": "Runtime reference to an approved Git BPMN/template version.",
      "allowed_data_classes": [
        "safe_metadata_only",
        "git_template_reference",
        "template_version"
      ],
      "blocked_data_classes": [
        "raw_mandate_content",
        "mutable_template_truth"
      ]
    },
    {
      "id": "process_instances",
      "purpose": "Concrete runtime execution of an approved process template for a matter.",
      "allowed_data_classes": [
        "safe_metadata_only",
        "process_status",
        "duration_band",
        "critical_path_status"
      ],
      "blocked_data_classes": [
        "raw_mandate_content",
        "document_full_text"
      ]
    },
    {
      "id": "process_events",
      "purpose": "Append-oriented event metadata for process progress and external-gate status.",
      "allowed_data_classes": [
        "safe_metadata_only",
        "event_type",
        "event_status",
        "redacted_external_system_label"
      ],
      "blocked_data_classes": [
        "raw_mandate_content",
        "external_payload_without_separate_gate",
        "credentials"
      ]
    },
    {
      "id": "audit_events",
      "purpose": "Redacted audit metadata for gates, reviews and operator-visible evidence.",
      "allowed_data_classes": [
        "safe_metadata_only",
        "gate_status",
        "review_status",
        "redacted_actor_reference"
      ],
      "blocked_data_classes": [
        "raw_mandate_content",
        "tokens",
        "secret_values",
        "full_identity_claims"
      ]
    }
  ],
  "anchor_schema": {
    "status": "artifact_only_no_apply",
    "artifact": "deploy/database/atp-runtime-anchor-schema.sql",
    "tables": [
      {
        "name": "nac_tenants",
        "anchor_id": "tenants",
        "json_contract": "nac.tenant-runtime/v0.1"
      },
      {
        "name": "nac_user_bindings",
        "anchor_id": "user_bindings",
        "json_contract": "nac.user-binding/v0.1"
      },
      {
        "name": "nac_matters",
        "anchor_id": "matters",
        "json_contract": "nac.matter-anchor/v0.1"
      },
      {
        "name": "nac_process_templates",
        "anchor_id": "process_templates",
        "json_contract": "nac.process-template-binding/v0.1"
      },
      {
        "name": "nac_process_instances",
        "anchor_id": "process_instances",
        "json_contract": "nac.process-instance-status/v0.1"
      },
      {
        "name": "nac_process_events",
        "anchor_id": "process_events",
        "json_contract": "nac.process-event/v0.1"
      },
      {
        "name": "nac_audit_events",
        "anchor_id": "audit_events",
        "json_contract": "nac.audit-event/v0.1"
      }
    ],
    "guardrails": {
      "idempotent_create_only": true,
      "drop_or_truncate_allowed": false,
      "raw_mandate_payload_columns_allowed": false,
      "tenant_boundary_required": true,
      "json_payload_check_required": true
    }
  },
  "json_payload_policy": {
    "schema_version_required": true,
    "payload_type_required": true,
    "redaction_class_required": true,
    "template_version_reference_required": true,
    "raw_mandate_content_allowed_before_separate_gate": false,
    "allowed_initial_payload_types": [
      "matter_status",
      "process_instance_status",
      "process_gate_status",
      "duration_estimate",
      "external_gate_metadata",
      "audit_metadata"
    ]
  },
  "graph_projection": {
    "status": "projection_contract_only",
    "target": "oracle_database_graph_projection",
    "node_types": [
      "Tenant",
      "UserBinding",
      "Session",
      "Matter",
      "ProcessTemplate",
      "ProcessInstance",
      "ProcessStep",
      "Gate",
      "ExternalSystem",
      "DocumentReference",
      "Deadline",
      "FeeEvent",
      "AuditEvent"
    ],
    "edge_types": [
      "belongs_to",
      "acts_as",
      "uses_template",
      "has_step",
      "requires",
      "blocks",
      "produces",
      "consumes",
      "sent_to",
      "received_from",
      "signed_by",
      "depends_on",
      "parallel_with",
      "critical_path_of",
      "fee_basis_for",
      "audited_by"
    ],
    "runtime_projection_vocabulary": {
      "node_types": [
        "process_instance",
        "gate",
        "external_system"
      ],
      "edge_types": [
        "has_event_gate",
        "touches_gate",
        "depends_on"
      ],
      "canonical_mapping": {
        "process_instance": "ProcessInstance",
        "gate": "Gate",
        "external_system": "ExternalSystem",
        "has_event_gate": "has_step",
        "touches_gate": "external_gate_touchpoint",
        "depends_on": "depends_on"
      }
    }
  },
  "guardrails": {
    "productive_schema_apply_approved": false,
    "productive_graph_activation_approved": false,
    "raw_mandate_data_in_git_allowed": false,
    "secrets_in_git_allowed": false,
    "oci_apply_approved": false,
    "protected_pr_required": true
  },
  "implementation_scope_v0": {
    "runtime_graph_adapter_entities": [
      "tenants",
      "user_bindings",
      "matters",
      "process_instances",
      "process_events",
      "audit_events"
    ],
    "schema_artifact_entities": [
      "tenants",
      "user_bindings",
      "matters",
      "process_templates",
      "process_instances",
      "process_events",
      "audit_events"
    ],
    "externalized_or_deferred_entities": [
      {
        "id": "sessions",
        "status": "externalized_in_identity_session_store",
        "runtime_boundary": "nac_identity.session_store.AtpSessionStore",
        "schema_artifact": "deploy/database/atp-onboarding-request-store.sql",
        "reason": "Sessions are part of the ATP runtime target, but not part of the process-event graph projection slice."
      },
      {
        "id": "process_templates",
        "status": "schema_anchor_and_template_ref_only",
        "runtime_boundary": "process_instances.payload.template_ref",
        "reason": "The v0.1 adapter carries approved template references on process instances; a dedicated template adapter method is deferred."
      }
    ]
  }
}
