{
  "schema_version": "nac.m365-azure-bff-live-activation/v1",
  "contract_id": "m365.azure_bff_live_activation",
  "title": "M365 Azure BFF Live Activation Runner",
  "status": "OFFLINE_READY",
  "leading_issue": "https://github.com/notariat8/NaC/issues/632",
  "parent_issue": "https://github.com/notariat8/NaC/issues/620",
  "acceptance_ids": [
    "AC-632-01",
    "AC-632-02",
    "AC-632-03",
    "AC-632-04",
    "AC-632-05",
    "AC-632-06",
    "AC-632-07",
    "AC-632-08"
  ],
  "purpose": "Execute the hash-bound Azure, Entra, Microsoft Graph REST v1.0 and site-scoped SPFx activation plan exactly once under one immutable owner approval binding; MVP resume is disabled until every provider write has provider-specific read-only reconciliation.",
  "source_offline_plan": {
    "contract_path": "workflows/contracts/m365-azure-bff-activation-plan.contract.json",
    "command": "nac m365 teams-sharepoint bff-azure-activation-plan --format json",
    "required_status": "READY",
    "expected_activation_sha256_source": "activation_hash emitted by the offline plan from the final clean approved commit",
    "expected_activation_sha256_pattern": "^[0-9a-f]{64}$",
    "expected_activation_sha256_must_be_captured_after_approved_commit_exists": true,
    "hash_recomputations_required": 2,
    "both_recomputations_must_equal_expected": true
  },
  "runner_interface": {
    "command": "nac m365 teams-sharepoint bff-azure-activate-live",
    "required_arguments": [
      "--owner-approved",
      "--execute-live-activation",
      "--expected-activation-hash <64-lowercase-hex>",
      "--approval-reference <immutable-github-issue-comment-url>",
      "--approval-body-sha256 <64-lowercase-hex>",
      "--approved-commit <40-lowercase-hex>",
      "--approved-tree <40-lowercase-hex>",
      "--azure-cli-toolchain-sha256 <64-lowercase-hex>",
      "--m365-cli-sha256 <64-lowercase-hex>",
      "--m365-node-sha256 <64-lowercase-hex>",
      "--build-python-sha256 <64-lowercase-hex>",
      "--build-node-sha256 <64-lowercase-hex>",
      "--build-npm-cli-sha256 <64-lowercase-hex>",
      "--gh-cli-sha256 <64-lowercase-hex>",
      "--provisioner-certificate-sha256 <64-lowercase-hex>",
      "--reason <non-empty-owner-reason>",
      "--correlation-id <safe-correlation-id>"
    ],
    "resume_argument_exposed": false,
    "resume_request_behavior": "reject_before_lock_or_provider_access_with_RESUME_DISABLED_FOR_MVP",
    "shell_execution_allowed": false,
    "argv_allowlist_required": true,
    "attestation_preparation": {
      "command": "nac m365 teams-sharepoint bff-azure-activation-attestations --bff-attestation-provisioner-certificate <public-certificate-path> --format json",
      "provider_requests_exact": 0,
      "private_key_reads_exact": 0,
      "output_status_required": "READY",
      "output_fields_required": [
        "toolchain_attestations",
        "toolchain_attestations_sha256",
        "live_cli_arguments"
      ]
    },
    "finalization_recovery": {
      "command": "nac m365 teams-sharepoint bff-azure-activation-recovery",
      "same_owner_binding_arguments_as_live_runner_required": true,
      "owner_approved_required": true,
      "read_only_inspection_default": true,
      "unlock_argument_exact": "--confirm-unlock",
      "provider_requests_exact": 0,
      "resume_enabled": false,
      "automatic_unlock_allowed": false,
      "output_fields_allowlisted": true
    }
  },
  "consolidated_owner_gate": {
    "gate_count_exact": 1,
    "owner_approved_exact": true,
    "expected_activation_sha256_required": true,
    "expected_activation_sha256_pattern": "^[0-9a-f]{64}$",
