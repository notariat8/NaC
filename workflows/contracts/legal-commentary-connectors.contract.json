      "allowed_connection_modes": [
        "mcp",
        "api"
      ],
      "activation_gate": "blocked_until_license_api_and_review",
      "allowed_evidence_fields": [
        "provider_id",
        "source_url",
        "citation",
        "checked_at",
        "checked_by",
        "license_status",
        "data_classes",
        "review_note"
      ],
