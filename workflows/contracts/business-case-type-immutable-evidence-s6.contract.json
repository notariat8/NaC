  "offline_output": {
    "status_exact": "S6_OFFLINE_FOUNDATION",
    "live_status_exact": "BLOCKED_PENDING_S7_APPROVAL",
    "production_worm_claim_exact": false,
    "required_production_ports_exact": [
      "postgresql_outbox",
      "broker_with_dlq",
      "detached_signature_and_daily_anchor",
      "worm_journal_with_retention_readback",
      "persistent_reconciliation_store"
    ],
    "next_gate_exact": "S6B_PROVIDER_ADAPTERS_AND_S7_DUAL_APPROVAL",
    "zero_activity_counters_exact": [
      "network_calls",
      "provider_calls",
      "tenant_calls",
      "tenant_writes",
      "credential_reads",
      "live_mutations"
    ]
  },
  "acceptance_criteria": [
    {
      "id": "AC-S6-01",
      "requirement": "A canonical redacted envelope models intent, outcome, readback, reconciliation-required and reconciliation-closed evidence with strict phase order, contiguous sequence and SHA-256 hash chaining."
    },
    {
      "id": "AC-S6-02",
      "requirement": "Every declared mutation requires persisted intent before execution and outcome plus readback afterwards; operation idempotency, event-specific delivery keys, the ordered event-hash sequence, persisted tenant/principal-key bindings, an exclusive chain-head-bound publication claim and write-ahead progress make retry fail closed unless dual-control resume is explicitly authorized."
    },
    {
      "id": "AC-S6-03",
      "requirement": "Correlation, actor and closure principals carry the same persisted tenant_binding_sha256; actor, operator and approver additionally carry a matching persisted principal_key_binding_sha256. Cross-tenant or mixed-principal-key evidence fails closed while pseudonymous principal refs remain stable across ActorRef rotation."
    },
    {
      "id": "AC-S6-04",
      "requirement": "Explicit ports define the later PostgreSQL outbox, broker acknowledgements bound to delivery keys, deterministic chain-head-bound idempotency keys for signature anchor and WORM commit, independent readbacks and a restart-safe reconciliation store with security-bound claims, resumable progress and completed-result replay."
    },
    {
      "id": "AC-S6-05",
      "requirement": "Every event requires at least ten years retention and legal-hold capability; production additionally requires policy readback, monthly access review and separation of duties, none of which S6a claims to implement."
    },
    {
      "id": "AC-S6-06",
      "requirement": "Publication claims bind chain head, tenant, principal-key identity and the complete ordered event-hash sequence. A pre-claim evidence-publication-incomplete requirement persists its available ordered event-hash prefix plus retry authorization and dual-control evidence; retry fails closed without a principal-key binding, and claim must exactly extend that prefix while atomically consuming the authorized requirement into publication state. Completed claims return result plus publication progress, which must match the current chain length, acknowledged count, head, anchor, signature and WORM bindings."
    },
    {
      "id": "AC-S6-07",
      "requirement": "The synthetic offline result is exactly S6_OFFLINE_FOUNDATION and BLOCKED_PENDING_S7_APPROVAL with zero network, provider, tenant, credential and live-mutation activity and no WORM or production durability claim."
    },
    {
      "id": "AC-S6-08",
      "requirement": "Negative gates reject tenant/principal-key drift, ordered event-hash prefix or complete-sequence drift, unbound pre-claim retry, claim or completion-progress drift, non-deterministic anchor/WORM operation keys, unauthorized retry and all prior evidence violations. Every external port exception, including ImmutableEvidenceError, is reduced to a fixed redacted boundary without provider detail."
    }
  ]
}
