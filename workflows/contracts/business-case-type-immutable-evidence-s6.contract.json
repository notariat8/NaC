    "publication_failure_close_supported_in_s6a": false,
    "publication_failure_retry_allowed_while_required": false,
    "normal_chain_recovery_after_missing_or_failed_readback_supported": true,
    "failed_closure_can_be_retried_after_new_verified_readback": true,
    "uncertain_outcome_requires_reconciliation_before_readback": true,
    "direct_readback_after_uncertain_outcome_allowed": false,
    "failed_closure_requires_new_successful_readback_before_reconciled_closure": true,
    "publication_failure_retry_after_dual_control_authorization": true,
    "publication_retry_authorization_operator_and_approver_must_differ": true,
    "publication_retry_resumes_same_chain_head_and_progress": true
  },
  "negative_gates": {
    "reject_exact": [
      "tampered_event_or_event_hash",
      "duplicate_event",
      "sequence_gap_or_reordered_phase",
      "previous_hash_mismatch",
      "foreign_correlation_or_binding",
      "missing_intent_outcome_or_readback",
      "raw_identity_secret_credential_or_payload",
      "retention_or_legal_hold_downgrade",
      "missing_port_ack_receipt_or_readback",
      "semantic_or_duplicate_provider_reference",
      "factory_provenance_or_post_build_mutation",
      "outbox_snapshot_tamper_or_partial_publish_retry",
      "same_reconciliation_operator_and_approver",
      "delivery_key_reuse_or_ack_binding_drift",
      "publication_progress_regression_or_reference_replacement",
      "same_principal_across_actor_key_rotation",
      "publication_retry_without_dual_control_authorization",
      "publication_claim_mismatch_or_parallel_owner",
      "completion_chain_head_or_signature_binding_drift",
      "closure_principal_ref_mismatch",
      "correlation_actor_operator_or_approver_tenant_binding_mismatch",
      "principal_key_binding_mismatch",
      "anchor_or_worm_idempotency_key_drift",
      "completed_claim_missing_or_inconsistent_publication_progress",
      "completed_result_event_count_or_progress_binding_drift",
      "external_port_error_detail_disclosure"
    ],
    "failure_mode": "fail_closed",
    "live_override_allowed": false,
    "partial_completion_allowed": false,
    "external_partial_publish_requires_reconciliation": true
  },
  "evidence_policy": {
    "synthetic_only": true,
    "redacted_only": true,
    "production_or_resolvable_matter_data_allowed": false,
    "raw_provider_or_graph_payloads_allowed": false,
    "documents_persons_free_text_allowed": false,
    "credentials_tokens_certificates_private_keys_allowed": false,
    "raw_actor_or_tenant_identifiers_allowed": false,
    "audit_journal_lite_is_worm_evidence": false,
    "offline_outbox_is_postgresql_claim": false,
    "offline_chain_is_signature_or_anchor_claim": false,
    "offline_chain_is_worm_claim": false,
