{
  "schema_version": "nac.customer-tenant-onboarding/v0.1",
  "contract_id": "workflow.customer_tenant_onboarding",
  "title": "Customer-Centric Tenant Onboarding",
  "status": "final_m365_mvp",
  "last_update": "2026-07-06",
  "purpose": "Definiert die sichtbare Neukundenreise von www-n8 bis zum initialen Kundenadmin in NaC. NaC führt Domain-Readiness, DNS-Challenge, SaaS-Admin-Review, Owner-Apply-Plan und die M365-/SharePoint-Tenant-Registry.",
  "public_entry_surface": "www-n8",
  "app_surface": "app.notariat8.de",
  "customer_journey": [
    "customer_domain_readiness",
    "admin_email_capture",
    "dns_txt_challenge",
    "live_dns_txt_check",
    "dns_status_check",
    "return_later_resume",
    "saas_admin_review",
    "customer_admin_invitation"
  ],
  "saas_admin_journey": [
    "saas_admin_review_queue",
    "domain_readiness_review",
    "tenant_registry_plan_review",
    "owner_apply_approval",
    "m365_graph_privileged_change_plan",
    "invitation_audit_record"
  ],
  "m365_target_model": {
    "identity_provider": "entra_id",
    "tenant_binding": "microsoft_365_group_membership",
    "workspace_strategy": "team_per_notary_team",
    "technical_owner_user": "funktion8@funktion8.de",
    "productive_write_gate": "owner_apply_approval",
    "graph_rest_only": true
  },
  "sharepoint_target_model": {
    "strategy": "team_site_lists_and_document_libraries",
    "required_controls": [
      "tenant_registry",
      "tenant_id",
      "matter_id",
      "role_bound_site_permission",
      "time_limited_delegation_grant",
      "audit_journal_lite"
    ]
  },
  "apply_gates": [
    "domain_ready",
    "dns_txt_verified",
    "saas_admin_reviewed",
    "owner_apply_approved",
    "audit_event_prepared",
    "rollback_plan_prepared"
  ],
  "guardrails": {
    "customer_oci_console_required": false,
    "oci_atp_mvp_data_plane_archived": true,
    "m365_graph_rest_only": true,
    "legacy_sharepoint_api_allowed": false,
    "www_n8_accepts_mandate_data": false,
    "productive_graph_write_without_owner_apply": false,
    "github_contains_secrets": false
  }
}
