{
  "schema_version": "nac.oci-tenant-identity-contract/v0.1",
  "contract_id": "workflow.oci_tenant_identity",
  "title": "OCI Identity Domains Tenant-Onboarding",
  "status": "planned_mvp",
  "last_update": "2026-06-17",
  "purpose": "Definiert die prüfbare Grenze für tenant-aware NaC-SaaS-Onboarding mit Oracle OCI Identity Domains als IdP. Der erste Stand erzeugt Domain-Readiness und Admin-Provisioning-Pläne ohne produktive Identity-Writes.",
  "idp": "oracle_oci_identity_domains",
  "productive_identity_writes_allowed": false,
  "end_user_console_work_allowed": false,
  "oci_identity_domain_endpoints": [
    "/admin/v1/Users",
    "/admin/v1/Groups",
    "/.well-known/openid-configuration",
    "/oauth2/v1/authorize",
    "/oauth2/v1/token"
  ],
  "required_gates": [
    "domain_ready",
    "dns_txt_verification",
    "dry_run_plan",
    "owner_review",
    "owner_apply_approval",
    "dns_verified",
    "audit_event_prepared",
    "rollback_plan_prepared",
    "server_generated_state",
    "server_generated_nonce",
    "idp_login_validated",
    "nac_role_gate"
  ],
  "nac_roles": [
    "nac-tenant-admin",
    "nac-notary",
    "nac-case-worker",
    "nac-auditor",
    "nac-billing-viewer"
  ],
  "allowed_operations": [
    "domain_readiness_preview",
    "oci_admin_provisioning_dry_run",
    "oci_identity_apply_request_dry_run",
    "oci_oidc_login_intent",
    "oci_oidc_id_token_jwks_verification",
    "oci_oidc_token_exchange_contract",
    "oci_oidc_token_exchange_server_adapter",
    "oci_oidc_session_cookie_boundary",
    "oci_oidc_session_cookie_validation",
    "protected_start_status_page",
    "role_mapping_preview",
    "read_only_oci_diagnostics"
  ],
  "blocked_operations": [
    "create_oci_user_without_owner_apply_approval",
    "create_oci_group_without_owner_apply_approval",
    "execute_oci_write_without_apply_request",
    "store_client_credential_material_in_product_repo",
    "store_api_key_material_in_product_repo",
    "store_oidc_client_secret_in_product_repo",
    "authorize_tenant_from_query_hint",
    "skip_nac_role_gate_after_idp_login",
    "require_end_user_oci_console_work",
    "store_mandate_data_in_public_site"
  ],
  "login_intent_schema": {
    "schema_version": "nac.oci-login-intent/v0.1",
    "required": [
      "mode",
      "provider",
      "tenant_context",
      "endpoints",
      "oidc",
      "authorization_url",
      "guardrails"
    ],
    "flow": "authorization_code",
    "tenant_hint_authorizes_access": false,
    "requires_server_generated_state_and_nonce": true
  },
  "callback_session_contract_schema": {
    "schema_version": "nac.oidc-session-boundary/v0.2",
    "required": [
      "token_exchange",
      "jwt_validation",
      "role_gate",
      "session",
      "guardrails"
    ],
    "live_token_exchange_in_contract_slice": true,
    "live_token_exchange_requires_valid_state": true,
    "live_token_exchange_requires_server_side_adapter": true,
    "verified_id_token_required_before_role_gate": true,
    "verified_id_token_claims_exposed_in_public_result": false,
    "session_cookie_issued_in_contract_slice": true,
    "session_cookie_requires_positive_role_gate": true,
    "session_cookie_contains_tokens_or_claims": false,
    "session_cookie_max_ttl_seconds": 3600,
    "workspace_opened_in_contract_slice": false,
    "server_session_store_in_contract_slice": true,
    "server_session_store_required_before_full_workspace": true,
    "server_session_revocation_fails_closed": true,
    "server_session_store_contains_tokens_or_claims": false,
    "session_audit_contract_in_contract_slice": true,
    "session_cookie_validation_in_contract_slice": true,
    "session_cookie_validation_opens_only_protected_start_status": true,
    "session_cookie_validation_loads_mandate_data": false,
    "full_workspace_opened_after_session_validation": false,
    "requires_verified_claims_before_role_gate": true,
    "session_validation_schema": {
      "schema_version": "nac.session-validation/v0.1",
      "valid_session_allows_protected_start_page": true,
      "invalid_missing_tampered_or_expired_cookie_fails_closed": true,
      "session_cookie_exposed_in_result": false,
      "claims_exposed_in_result": false,
      "tokens_returned_in_result": false,
      "mandate_data_loaded_in_result": false
    },
    "claim_boundary_schema": {
      "schema_version": "nac.oidc-claim-boundary/v0.1",
      "verified_claims_forwarded_to_role_gate_only": true,
      "claims_exposed_in_public_result": false,
      "tokens_returned_in_public_result": false,
      "session_cookie_issued_in_claim_boundary_slice": false,
      "workspace_opened_in_claim_boundary_slice": false
    }
  },
  "token_exchange_contract_schema": {
    "schema_version": "nac.oidc-token-exchange/v0.1",
    "required": [
      "status",
      "configuration",
      "mode",
      "guardrails"
    ],
    "allowed_statuses": [
      "not_configured",
      "not_started",
      "verified",
      "invalid",
      "failed",
      "unavailable"
    ],
    "server_side_live_adapter_available": true,
    "live_token_exchange_requires_injected_client_secret_and_id_token_verifier": true,
    "id_token_verifier_uses_oidc_discovery_jwks": true,
    "id_token_verifier_validates_rs256_issuer_audience_and_expiry": true,
    "live_token_exchange_performed_by_default": false,
    "vault_secret_read_in_contract_slice": true,
    "vault_secret_read_requires_valid_state_code_metadata_and_id_token_verifier": true,
    "tokens_returned_in_public_result": false,
    "provider_error_details_exposed": false,
    "workspace_opened_in_token_exchange_slice": false,
    "session_cookie_issued_in_token_exchange_slice": false
  },
  "domain_readiness_schema": {
    "schema_version": "nac.tenant-domain-readiness/v0.1",
    "required": [
      "domain",
      "tenant_slug",
      "admin_email",
      "ready",
      "blocking_findings",
      "verification"
    ]
  },
  "admin_provisioning_schema": {
    "schema_version": "nac.oci-admin-provisioning-plan/v0.1",
    "required": [
      "mode",
      "tenant_slug",
      "domain",
      "requires_human_approval",
      "target",
      "admin_user",
      "groups",
      "planned_writes"
    ]
  },
  "apply_readiness_schema": {
    "schema_version": "nac.oci-identity-apply-request/v0.1",
    "required": [
      "mode",
      "tenant_slug",
      "domain",
      "ready_to_apply",
      "productive_write_executed",
      "approval",
      "audit",
      "rollback",
      "planned_writes"
    ]
  },
  "guardrails": {
    "real_mandate_data_in_git": false,
    "credential_material_in_git": false,
    "productive_writes_in_first_track": false,
    "human_approval_required_for_apply": true,
    "audit_event_required_for_apply": true,
    "rollback_plan_required_for_apply": true,
    "apply_request_contains_credential_material": false,
    "static_site_stores_identity_material": false,
    "login_intent_contains_credential_material": false,
    "tenant_hint_authorizes_access": false,
    "nac_role_gate_required_after_idp_login": true
  }
}
