    "privacy_guards": {
      "stores_raw_graph_response": false,
      "stores_raw_graph_path": false,
      "stores_raw_drive_item_id": false,
      "stores_tokens_or_secrets": false,
      "stores_raw_matter_values": false
    }
  },
