    "request_plan_tools": [
      "bpmn_model_get",
      "process_register_list",
      "bpmn_viewer_overlay_get"
    ],
    "required_checks": [
      "single_process_register_match",
      "process_status_approved",
      "process_viewer_enabled",
      "overlay_policy_metadata_only",
      "linked_bpmn_model_found",
      "linked_bpmn_model_renderable"
