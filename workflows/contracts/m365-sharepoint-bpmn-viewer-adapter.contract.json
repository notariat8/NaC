    "status": "offline_runtime_readiness_no_live_deploy",
    "redacted_artifact_kind": "redacted_offline_readiness_json",
    "spfx_package_allowed_now": false,
    "app_catalog_upload_allowed_now": false,
    "tenant_apply_allowed_now": false,
    "live_bpmn_content_read_enabled_now": false,
