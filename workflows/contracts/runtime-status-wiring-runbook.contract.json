{
  "schema_version": "nac.workflow-contract/v0.1",
  "contract_id": "workflow.runtime_status_wiring_runbook",
  "status": "owner_free_contract_first",
  "purpose": "Document the safe path from the current in-memory demo runtime status to a future M365/SharePoint-backed runtime status for the first Immobilienkaufvertrag route.",
  "route": "/workspace/immobilienkaufvertrag",
  "current_store": "in_memory_demo_adapter",
  "runtime_store": "m365_sharepoint_adapter_future_slice",
  "current_pipeline": [
    "metadata_fixture",
    "InMemoryRuntimeStore",
    "demo_runtime_seed",
    "process_events",
    "runtime_graph_projection",
    "runtime_status_read_model",
    "runtime_status_presenter",
    "protected_workspace_route"
  ],
  "future_owner_gated_pipeline": [
    "M365 SharePoint RuntimeStoreAdapter implementation",
    "Graph REST list provisioning",
    "serverless Function configuration",
    "live route binding"
  ],
  "runtime_metadata_source_v0": {
    "source_env": "NAC_FIRST_MATTER_RUNTIME_SOURCE",
    "accepted_source_values": [
      "json",
      "metadata-json",
      "sharepoint",
      "m365",
      "m365-sharepoint"
    ],
    "object_key_env": "NAC_FIRST_MATTER_RUNTIME_OBJECT_KEY",
    "default_object_key": "DEMO-PROCESS-IMMOBILIENKAUF-01",
    "payload_column_env": "NAC_FIRST_MATTER_RUNTIME_PAYLOAD_COLUMN",
    "default_payload_column": "payload_json",
    "missing_row_fetcher_behavior": "fail_closed_runtime_metadata_source_unavailable",
    "legacy_atp_values_behavior": "fail_closed_legacy_atp_runtime_source_archived",
    "packaged_fallback_when_explicit_source_enabled": false,
    "requires_existing_graph_access": true,
    "database_migration_required": false,
    "cloud_apply_required": false,
    "secrets_or_wallet_change_required": false
  },
  "guardrails": {
    "mandate_data_allowed": false,
    "productive_xnp_action_allowed": false,
    "secrets_allowed": false,
    "oci_apply_allowed": false,
    "browser_identifiers_allowed": false,
    "provider_details_allowed": false,
    "fail_closed_required": true,
    "append_only_process_events_required": true,
    "graph_projection_derived_from_events": true
  },
  "owner_gates_required_for": [
    "M365 SharePoint list provisioning",
    "Graph permission changes",
    "serverless Function configuration changes",
    "productive XNP/SNP action",
    "mandate data writes"
  ]
}
