  "focused_test_names": {
    "acceptance": [
      "test_plan_is_exactly_bounded_and_deterministic",
      "test_inflight_attempt_is_not_replayed_after_crash",
      "test_runtime_monitor_failure_blocks_before_transport",
      "test_runtime_execution_unit_budget_includes_remaining_dispatches",
      "test_pending_safety_check_is_restart_terminal_without_dispatch",
      "test_artifact_store_writes_only_redacted_aggregate"
    ],
    "monitor": [
      "test_exact_read_request_and_multi_instance_aggregation",
      "test_unknown_response_shape_is_rejected_at_each_level",
      "test_nonzero_always_ready_activity_is_blocked",
      "test_window_must_be_utc_minute_aligned_bounded_and_settled",
      "test_observation_is_aggregate_only_redacted_and_hash_deterministic"
    ],
    "lease": [
      "test_acquire_is_exact_conditional_put_and_persists_held",
      "test_assert_held_is_exact_conditional_head_with_read_identity",
      "test_release_is_exact_put_then_conditional_head_and_durable",
      "test_crash_after_remote_acquire_resumes_by_head_without_reacquire",
      "test_resume_requires_same_lease_id_before_network",
      "test_foreign_lost_and_binding_drift_heads_fail_closed",
      "test_adapter_has_no_disallowed_lease_or_blob_operations"
    ]
  },
  "invariants": [
    "The measurement mode is exactly endpoint_scoped_conservative_measurement.",
    "Tenant-wide SharePoint baseline, request allowance and resource-unit allowance are explicitly NOT_CLAIMED.",
    "The fixed plan dispatches exactly 500 synthetic GETs as 1, 1, 90 at 10 seconds, 120 at 60 seconds and 288 at 300 seconds.",
    "Concurrency is exactly one, the global rate never exceeds six dispatches per minute and catch-up bursts are forbidden.",
    "The static full-run projection is exactly 30000 GB-s and observed app-wide delta plus projected remaining execution never exceeds 120000 GB-s.",
    "Azure Monitor values are app-wide deltas and are never represented as endpoint attribution or tenant-wide SharePoint capacity.",
    "Azure Monitor uses only the fixed ARM metrics endpoint, five fixed metrics, Total, PT1M, Instance eq '*', UTC minute-aligned bounded windows and a 300-second settlement delay.",
    "Every Azure Monitor metric sums all Total points across all unique Instance series and unknown response fields fail closed.",
    "The lease adapter exposes only acquire(-1), assert_held and release for one dedicated pre-provisioned blob.",
    "The lease state machine is ACQUIRE_INTENT, ACQUIRE_IN_FLIGHT, HELD, RELEASE_INTENT and RELEASED; PASSED is possible only after RELEASED is durable.",
    "Crash or resume requires the same lease ID, target and lease binding; a lost or foreign lease blocks without dispatch and no automatic reacquire occurs.",
    "The runtime lease adapter forbids lease break, delete, blob create and automatic reacquire; the separately bound bootstrap may create the dedicated blob once before lease acquisition.",
    "The exact owner gate binds commit, tree, toolchain, activation, contract, policy, source, parameter, target, monitor, lease, runtime, evidence and infrastructure hashes.",
    "Any owner-gate binding drift blocks before the first write.",
    "The Azure Monitor adapter, dedicated Blob lease and central owner-gated live CLI are implemented offline.",
    "Exactly one immutable owner approval binds unlocked WORM baseline deployment, coordination infrastructure deployment, runtime execution and redacted evidence.",
    "The owner binding includes commit, tree, toolchain, activation, contract, policy, source, parameter and target hashes; partial approvals and caller-supplied hashes are rejected.",
    "The WORM baseline remains unlocked; an irreversible policy lock is outside scope and forbidden.",
    "This PR creates or changes zero Azure resources, performs zero live Blob or lease operations, dispatches zero synthetic GETs and applies zero irreversible WORM locks.",
    "Evidence is aggregate-only and redacted and repeats the NOT_CLAIMED tenant-wide SharePoint and monetary baseline position."
  ],
