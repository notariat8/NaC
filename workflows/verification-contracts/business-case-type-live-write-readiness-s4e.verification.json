{
  "schemaVersion": "nac.verification-contract/v0.1",
  "id": "business-case-type-live-write-readiness-s4e",
  "title": "BusinessCaseType production adapter readiness S4e verification",
  "issue": "https://github.com/notariat8/NaC/issues/702",
  "appliesWhen": {
    "paths": [
      "src/nac_m365_graph/business_case_type_live_write_readiness.py",
      "src/nac_cli/cli.py",
      "scripts/validate_business_case_type_live_write_readiness.py",
      "tests/test_business_case_type_live_write_readiness.py",
      "tests/test_business_case_type_live_write_readiness_cli.py",
      "tests/test_business_case_type_live_write_readiness_contract.py",
      "workflows/contracts/business-case-type-live-write-readiness-s4e.contract.json",
      "workflows/verification-contracts/business-case-type-live-write-readiness-s4e.verification.json"
    ]
  },
  "requiredContext": [
    "AGENTS.md",
    "docs/de/superpowers/specs/2026-07-29-business-case-type-live-write-readiness-s4e-design.md",
    "docs/de/superpowers/plans/2026-07-29-business-case-type-live-write-readiness-s4e.md",
    "workflows/contracts/business-case-type-live-write-boundary-s4d.contract.json"
  ],
  "checks": [
    "python3 -m unittest tests.test_business_case_type_live_write_readiness tests.test_business_case_type_live_write_readiness_cli tests.test_business_case_type_live_write_readiness_contract",
    "python3 scripts/validate_business_case_type_live_write_readiness.py",
    "python3 scripts/nac.py contracts verify",
    "python3 scripts/validate_spec_traceability.py",
    "python3 scripts/validate_language_parity.py",
    "python3 scripts/validate_doc_links.py",
    "git diff --check",
    "python3 -m compileall -q src scripts tests",
    "python3 scripts/quality_gate.py --profile strict"
  ],
  "requiredEvidence": [
    "The current repository state is BLOCKED without reading credentials or using network access.",
    "A complete synthetic adapter shape reaches S4E_READY_OFFLINE but never authorizes a live write.",
    "Provisioning, BusinessCase writer and BFF principals are pairwise distinct.",
    "Exact Sites.Selected/write and Sites.Selected/read boundaries are enforced.",
    "WORM lock and all durable evidence ports are mandatory.",
    "Output contains no principal hashes, credential paths, tokens or provider error bodies.",
    "Independent base...head review has no unresolved P1 or P2 findings."
  ],
  "invariants": [
    "The provisioning app never executes business-data writes.",
    "The BFF UAMI remains read-only.",
    "No live Graph, Entra, SharePoint, Teams or Azure action occurs.",
    "S4E_READY_OFFLINE is not live authorization."
  ],
  "thresholds": {
    "socketOrDnsCalls": 0,
    "externalCredentialStoreReads": 0,
    "graphCalls": 0,
    "azureCalls": 0,
    "tenantWrites": 0,
    "unresolvedP1OrP2Findings": 0
  },
  "passCondition": {
    "allChecksPass": true,
    "currentStatusExact": "BLOCKED",
    "completeSyntheticShapeStatusExact": "S4E_READY_OFFLINE"
  },
  "failureBehavior": {
    "mode": "fail_closed",
    "mergeAllowed": false,
    "liveRetryAllowed": false,
    "ownerInputRequiredForLiveBoundary": true
  }
}
