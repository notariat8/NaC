{
  "schema_version": "nac.verification-contract/v0.1",
  "contract_id": "verification.codex_agent_context_index_audit",
  "title": "Codex Agent Context Index Audit Verification",
  "status": "active_mvp",
  "applies_when": {
    "paths": [
      "agent-context/index.json",
      "agent-context/subagent-registry.json",
      ".codex/hooks/**",
      ".codex/rules/**",
      "docs/*/operations/codex-worktree-operating-model.md",
      "docs/*/operations/codex-subagent-operating-gate.md",
      "docs/*/operations/codex-memory-hooks-operating-model.md",
      "docs/*/operations/codex-command-rules-operating-model.md",
      "docs/*/operations/codex-5h-batch-run-envelope.md",
      "workflows/verification-contracts/codex-*.verification.json",
      "scripts/validate_codex_agent_context_index_audit.py",
      "tests/test_codex_agent_context_index_audit.py"
    ]
  },
  "required_context": {
    "always_on": [
      "AGENTS.md",
      ".codex/config.toml"
    ],
    "scoped": [
      "agent-context/index.json",
      "workflows/verification-contracts/"
    ],
    "on_demand": [
      "docs/de/agent-context/README.md",
      "docs/en/agent-context/README.md",
      "workflows/verification-contracts/codex-agent-context-index-audit.verification.json"
    ],
    "runtime": [
      "fresh nac contracts verify output",
      "fresh quality-gate output"
    ]
  },
  "checks": [
    "python scripts/validate_codex_agent_context_index_audit.py",
    "python -m unittest tests.test_codex_agent_context_index_audit",
    "python scripts/nac.py contracts verify",
    "python scripts/quality_gate.py --profile strict"
  ],
  "invariants": [
    "Worktree, subagent, memory/hooks, command-rules and 5h-batch gates each have an agent-context category.",
    "Each gate category links its operating docs, validator, tests and verification contract.",
    "agent-context/index.json verification_contracts lists every gate verification contract.",
    "nac contracts verify includes the compact index-audit proof.",
    "No runtime output, secrets or mandate data become shared context."
  ],
  "thresholds": {
    "required_gate_count": 5,
    "required_verification_contract_count": 5,
    "minimum_required_paths_per_gate": 4
  },
  "required_evidence": [
    "agent_context_index",
    "gate_crosslink_matrix",
    "worktree_gate_crosslink",
    "subagent_gate_crosslink",
    "memory_hooks_gate_crosslink",
    "command_rules_gate_crosslink",
    "codex_5h_batch_run_envelope_crosslink",
    "nac_contracts_verify_summary",
    "quality_gate_result"
  ],
  "pass_condition": {
    "all_checks_pass": true,
    "all_gates_crosslinked": true,
    "contracts_verify_includes_index_audit": true
  },
  "failure_behavior": {
    "missing_gate_category": "fail_closed",
    "missing_verification_contract": "fail_closed",
    "missing_compact_verify_evidence": "fail_closed",
    "quality_gate_failure": "block_completion"
  }
}
